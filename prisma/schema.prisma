// FMF Trust Management System — Prisma Schema
// MySQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  PROGRAM_ADMIN
  FINANCE_ADMIN
  COMMITTEE_SECRETARY
  DATA_ENTRY_STAFF
  AUDITOR
  VOLUNTEER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  volunteer     Volunteer? @relation("VolunteerUser")
  auditLogs     AuditLog[]
  inviteTokens  InviteToken[]

  @@map("users")
}

model InviteToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("invite_tokens")
}

// ─────────────────────────────────────────────
// MEMBERS
// ─────────────────────────────────────────────

enum MembershipType {
  GENERAL
  LIFE
  HONORARY
  PATRON
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

model Member {
  id             String         @id @default(uuid())
  memberNumber   String         @unique // e.g. FMF-M-0001
  name           String
  phone          String?
  email          String?
  address        String?        @db.Text
  city           String?
  state          String?
  joinDate       DateTime
  membershipType MembershipType @default(GENERAL)
  status         MemberStatus   @default(ACTIVE)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  committeeMembers CommitteeMember[]
  meetingAttendees MeetingAttendee[]

  @@map("members")
}

// ─────────────────────────────────────────────
// VOLUNTEERS & ONBOARDING PIPELINE
// ─────────────────────────────────────────────

enum PipelineStage {
  APPLICATION
  DOCUMENT_VERIFICATION
  INTERVIEW
  TRAINING
  APPROVED
  REJECTED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
}

model Volunteer {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  phone           String?
  address         String?       @db.Text
  city            String?
  district        String?
  state           String?
  skills          Json?         // array of strings
  interests       Json?         // array of strings
  contributionType String?
  availability    String?       // free text or JSON
  motivation      String?       @db.Text
  currentStage    PipelineStage @default(APPLICATION)
  isSuspended     Boolean       @default(false)
  suspendedAt     DateTime?
  suspensionReason String?      @db.Text
  rejectedAt      DateTime?
  rejectionReason String?       @db.Text
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Stage records
  stages          VolunteerStage[]

  // Login user (created on Approved)
  userId          String?       @unique
  user            User?         @relation("VolunteerUser", fields: [userId], references: [id])

  // Activity
  hoursLogs       VolunteerHoursLog[]
  eventAssignments EventAssignment[]
  committeeMembers CommitteeMember[]

  @@map("volunteers")
}

model VolunteerStage {
  id            String        @id @default(uuid())
  volunteerId   String
  volunteer     Volunteer     @relation(fields: [volunteerId], references: [id])
  stage         PipelineStage
  status        StageStatus   @default(PENDING)
  notes         String?       @db.Text
  conductedBy   String?       // name of interviewer/verifier
  conductedAt   DateTime?
  completedAt   DateTime?
  documents     Json?         // array of { name, url }
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([volunteerId, stage])
  @@map("volunteer_stages")
}

model VolunteerHoursLog {
  id          String     @id @default(uuid())
  volunteerId String
  volunteer   Volunteer  @relation(fields: [volunteerId], references: [id])
  eventId     String?
  event       Event?     @relation(fields: [eventId], references: [id])
  date        DateTime
  activity    String
  hours       Float
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("volunteer_hours_logs")
}

// ─────────────────────────────────────────────
// DONATIONS & 80G RECEIPTS
// ─────────────────────────────────────────────

enum PaymentMode {
  CASH
  CHEQUE
  NEFT
  RTGS
  IMPS
  UPI
  DEMAND_DRAFT
  ONLINE
}

enum DonationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Donation {
  id               String         @id @default(uuid())
  receiptNumber    String         @unique // e.g. FMF/2026-27/0001
  fiscalYear       String         // e.g. 2026-27
  donorName        String
  donorPhone       String?
  donorEmail       String?
  donorPan         String?
  donorAddress     String?        @db.Text
  amount           Decimal        @db.Decimal(12, 2)
  date             DateTime
  paymentMode      PaymentMode
  chequeNumber     String?
  bankName         String?
  purpose          String?
  tier             String?
  status           DonationStatus @default(CONFIRMED)
  notes            String?        @db.Text
  receiptEmailed   Boolean        @default(false)
  receiptEmailedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  receipt          DonationReceipt?

  @@map("donations")
}

model DonationReceipt {
  id          String    @id @default(uuid())
  donationId  String    @unique
  donation    Donation  @relation(fields: [donationId], references: [id])
  pdfPath     String?   // server-side stored path
  generatedAt DateTime  @default(now())

  @@map("donation_receipts")
}

// ─────────────────────────────────────────────
// MEETING MINUTES
// ─────────────────────────────────────────────

enum MeetingType {
  BOARD
  COMMITTEE
  GENERAL_BODY
  AD_HOC
}

enum MinuteStatus {
  DRAFT
  UNDER_REVIEW
  FINALIZED
}

model MeetingMinute {
  id           String       @id @default(uuid())
  meetingType  MeetingType
  title        String
  date         DateTime
  location     String?
  onlineLink   String?
  committeeId  String?
  committee    Committee?   @relation(fields: [committeeId], references: [id])
  status       MinuteStatus @default(DRAFT)
  finalizedAt  DateTime?
  pdfPath      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attendees    MeetingAttendee[]
  agendaItems  AgendaItem[]
  actionItems  ActionItem[]
  addendums    MeetingAddendum[]

  @@map("meeting_minutes")
}

model MeetingAttendee {
  id        String        @id @default(uuid())
  minuteId  String
  minute    MeetingMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  memberId  String?
  member    Member?       @relation(fields: [memberId], references: [id])
  name      String        // denormalized for guests/non-members
  isAbsent  Boolean       @default(false)

  @@map("meeting_attendees")
}

model AgendaItem {
  id          String        @id @default(uuid())
  minuteId    String
  minute      MeetingMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  orderIndex  Int
  title       String
  notes       String?       @db.Text
  decisions   String?       @db.Text
  createdAt   DateTime      @default(now())

  @@map("agenda_items")
}

model ActionItem {
  id          String        @id @default(uuid())
  minuteId    String
  minute      MeetingMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)
  description String        @db.Text
  ownerName   String
  dueDate     DateTime?
  status      String        @default("OPEN") // OPEN | IN_PROGRESS | DONE | DEFERRED
  closedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("action_items")
}

model MeetingAddendum {
  id        String        @id @default(uuid())
  minuteId  String
  minute    MeetingMinute @relation(fields: [minuteId], references: [id])
  content   String        @db.Text
  addedBy   String
  addedAt   DateTime      @default(now())

  @@map("meeting_addendums")
}

// ─────────────────────────────────────────────
// COMMITTEES & DEPARTMENTS
// ─────────────────────────────────────────────

enum CommitteeType {
  COMMITTEE
  DEPARTMENT
}

model Committee {
  id          String        @id @default(uuid())
  name        String
  type        CommitteeType @default(COMMITTEE)
  purpose     String?       @db.Text
  isArchived  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     CommitteeMember[]
  meetings    MeetingMinute[]
  events      Event[]

  @@map("committees")
}

enum CommitteeMemberRole {
  CHAIRPERSON
  SECRETARY
  TREASURER
  MEMBER
  ADVISOR
}

model CommitteeMember {
  id           String              @id @default(uuid())
  committeeId  String
  committee    Committee           @relation(fields: [committeeId], references: [id])
  memberId     String?
  member       Member?             @relation(fields: [memberId], references: [id])
  volunteerId  String?
  volunteer    Volunteer?          @relation(fields: [volunteerId], references: [id])
  designation  String?
  role         CommitteeMemberRole @default(MEMBER)
  termStart    DateTime?
  termEnd      DateTime?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())

  @@map("committee_members")
}

// ─────────────────────────────────────────────
// EVENTS & CALENDAR
// ─────────────────────────────────────────────

enum EventType {
  WORKSHOP
  SEMINAR
  OUTREACH
  FUNDRAISER
  TRAINING
  MEETING
  OTHER
}

enum EventStatus {
  PLANNED
  ONGOING
  COMPLETED
  CANCELLED
}

model Event {
  id           String      @id @default(uuid())
  name         String
  type         EventType   @default(OTHER)
  description  String?     @db.Text
  startDate    DateTime
  endDate      DateTime?
  location     String?
  onlineLink   String?
  status       EventStatus @default(PLANNED)
  committeeId  String?
  committee    Committee?  @relation(fields: [committeeId], references: [id])
  images       Json?       // array of { url: string, uploadedBy: string, uploadedAt: string }
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignments  EventAssignment[]
  hoursLogs    VolunteerHoursLog[]

  @@map("events")
}

enum AssignmentRole {
  LEAD
  SUPPORT
  COORDINATOR
  PARTICIPANT
}

model EventAssignment {
  id              String         @id @default(uuid())
  eventId         String
  event           Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteerId     String?
  volunteer       Volunteer?     @relation(fields: [volunteerId], references: [id])
  role            AssignmentRole @default(PARTICIPANT)
  taskDescription String?        @db.Text
  createdAt       DateTime       @default(now())

  @@map("event_assignments")
}

// ─────────────────────────────────────────────
// ORGANIZATION SETTINGS (key-value store)
// ─────────────────────────────────────────────

model OrgSetting {
  key       String   @id
  value     String   @db.LongText
  updatedAt DateTime @updatedAt

  @@map("org_settings")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userName   String?  // denormalized
  action     String   // CREATE | UPDATE | DELETE | LOGIN | STAGE_CHANGE etc.
  entity     String   // Member | Volunteer | Donation | etc.
  entityId   String?
  entityName String?  // human-readable identifier
  diff       Json?    // { before: {}, after: {} }
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}
