# ==========================================
# Free Mind Foundation Portal - Environment Config
# Domain: portal.freemindfoundation.org.in
# ==========================================

# 1. Database (MySQL inside Docker Network)
# When running with Docker Compose, 'db' is the service hostname
DATABASE_URL="mysql://root:fmf_password@db:3306/fmf_db"
DB_ROOT_PASSWORD="fmf_password"
DB_NAME="fmf_db"

# 2. NextAuth Authentication
# NEXTAUTH_URL should match your production domain with HTTPS
NEXTAUTH_URL="https://portal.freemindfoundation.org.in"
# Generate a secure 32+ char secret: openssl rand -base64 32
NEXTAUTH_SECRET="change_me_to_a_random_32_character_string"

# 3. Email Provider (brevo | resend)
EMAIL_PROVIDER="brevo"
EMAIL_API_KEY="your-brevo-or-resend-api-key"
EMAIL_FROM="no-reply@freemindfoundation.org.in"
EMAIL_FROM_NAME="Free Mind Foundation"

# 4. Public App Configuration
NEXT_PUBLIC_APP_NAME="Free Mind Foundation"
NEXT_PUBLIC_APP_URL="https://portal.freemindfoundation.org.in"
